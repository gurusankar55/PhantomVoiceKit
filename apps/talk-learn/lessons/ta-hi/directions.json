    {
      "speaker": "A",
      "text": "सुनिए, बस स्टॉप कहाँ है?",
      "say": "ஸுனியே, பஸ் ஸ்டாப் கஹான் ஹை?",
      "meaning": "மன்னிக்கவும், பேருந்து நிறுத்தம் எங்கே இருக்கிறது?"
    },
    {
      "speaker": "B",
      "text": "सीधे जाइए, फिर बाएँ मुड़िए।",
      "say": "ஸீதே ஜாயியே, பிர் பாயேன் முடியே.",
      "meaning": "நேராகப் போங்கள், பிறகு இடதுபுறம் திரும்புங்கள்."
    },
    {
      "speaker": "A",
      "text": "फिर पाँच मिनट चलिए। स्टॉप मंदिर के पास है।",
      "say": "பிர் பாஞ்ச் மினட் சலியே. ஸ்டாப் மந்திர் கே பாஸ் ஹை.",
      "meaning": "பிறகு ஐந்து நிமிடம் நடங்கள். நிறுத்தம் கோயிலுக்கு அருகில் உள்ளது."
    },
    {
      "speaker": "B",
      "text": "क्या यहाँ से दूर है?",
      "say": "க்யா யஹான் ஸே தூர் ஹை?",
      "meaning": "இங்கிருந்து தூரமா?"
    },
    {
      "speaker": "A",
      "text": "नहीं, बहुत पास है। आप पैदल जा सकते हैं।",
      "say": "நஹின், பஹுத் பாஸ் ஹை. ஆப் பைதல் ஜா ஸக்தே ஹைன்.",
      "meaning": "இல்லை, மிக அருகில்தான். நடந்தே போகலாம்."
