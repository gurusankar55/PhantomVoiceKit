    {
      "speaker": "A",
      "text": "आपको कहाँ जाना है?",
      "say": "ஆப்கோ கஹான் ஜானா ஹை?",
      "meaning": "நீங்கள் எங்கே போக வேண்டும்?"
    },
    {
      "speaker": "B",
      "text": "रेलवे स्टेशन चलिए। कितना लगेगा?",
      "say": "ரயில்வே ஸ்டேஷன் சலியே. கித்னா லகேகா?",
      "meaning": "ரயில் நிலையத்துக்கு, தயவுசெய்து. எவ்வளவு ஆகும்?"
    },
    {
      "speaker": "A",
      "text": "एक सौ पचास रुपये लगेंगे।",
      "say": "ஏக் ஸௌ பசாஸ் ருபயே லகேங்கே.",
      "meaning": "நூற்று ஐம்பது ரூபாய் ஆகும்."
    },
    {
      "speaker": "B",
      "text": "यह बहुत ज़्यादा है। मीटर से चलिए।",
      "say": "யேஹ் பஹுத் ஜ்யாதா ஹை. மீட்டர் ஸே சலியே.",
      "meaning": "அது அதிகம். மீட்டர் போடுங்கள்."
    },
    {
      "speaker": "A",
      "text": "ठीक है, मीटर से चलता हूँ। बैठिए।",
      "say": "டீக் ஹை, மீட்டர் ஸே சல்தா ஹூன். பைதியே.",
      "meaning": "சரி, மீட்டர் போடுகிறேன். உட்காருங்கள்."
    },
    {
      "speaker": "B",
      "text": "यहीं रोक दीजिए। धन्यवाद।",
      "say": "யஹீன் ரோக் தீஜியே. தன்யவாத்.",
      "meaning": "இங்கே நிறுத்துங்கள். நன்றி."
    }
  ],
