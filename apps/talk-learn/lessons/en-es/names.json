    {
      "speaker": "A",
      "text": "Soy Kumar. ¿De dónde eres?",
      "say": "soy koo-MAR. de DON-de E-res?",
      "meaning": "I am Kumar. Where are you from?"
    },
    {
      "speaker": "B",
      "text": "Soy de Madurai. ¿Eres de aquí?",
      "say": "soy de ma-DOO-rai. E-res de a-KEE?",
      "meaning": "I am from Madurai. Are you from here?"
