{
  "lines": [
    {
      "speaker": "A",
      "text": "ഇന്ന് ഏത് പച്ചക്കറിയാണ് വേണ്ടത്?",
      "say": "இன்னு ஏது பச்சக்கறியாணு வேண்டது?",
      "meaning": "இன்று என்ன காய்கறி வேண்டும்?"
    },
    {
      "speaker": "B",
      "text": "അര കിലോ തക്കാളിയും ഉള്ളിയും തരൂ.",
      "say": "அர கிலோ தக்காளியும் உள்ளியும் தரூ.",
      "meaning": "அரை கிலோ தக்காளியும் வெங்காயமும் கொடுங்கள்."
    },
    {
      "speaker": "A",
      "text": "തക്കാളി പുതിയതാണ്. കിലോയ്ക്ക് നാൽപ്പത് രൂപ.",
      "say": "தக்காளி புதியதாணு. கிலோய்க்கு நால்ப்பது ரூப.",
      "meaning": "தக்காளி புதியது. கிலோ நாற்பது ரூபாய்."
    },
    {
      "speaker": "B",
      "text": "കുറച്ച് വില കൂടുതലാണ്. മുപ്പതിന് തരൂ.",
      "say": "குறச்சு வில கூடுதலாணு. முப்பதினு தரூ.",
      "meaning": "இது கொஞ்சம் அதிகம். முப்பது ரூபாய்க்குத் தாருங்கள்."
    },
    {
      "speaker": "A",
      "text": "ശരി, എടുത്തോളൂ. മല്ലിയിലയും വേണോ?",
      "say": "ஷரி, எடுத்தோளூ. மல்லியிலயும் வேணோ?",
      "meaning": "சரி, எடுத்துக்கொள்ளுங்கள். கொத்தமல்லியும் வேண்டுமா?"
    },
    {
      "speaker": "B",
      "text": "വേണം, ഒരു ചെറിയ കെട്ട്. നന്ദി.",
      "say": "வேணம், ஒரு செறிய கெட்டு. நந்தி.",
      "meaning": "ஆம், ஒரு சிறிய கட்டு. நன்றி."
    }
  ],
  "keyWords": [
