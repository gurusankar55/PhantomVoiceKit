{
  "lines": [
    {
      "speaker": "A",
      "text": "ചേട്ടാ, ഈ ഷർട്ടിന് എത്രയാണ്?",
      "say": "சேட்டா, ஈ ஷர்ட்டினு எத்ரயாணு?",
      "meaning": "ஐயா, இந்தச் சட்டை என்ன விலை?"
    },
    {
      "speaker": "B",
      "text": "എണ്ണൂറ് രൂപ. നല്ല കോട്ടൺ ആണ്.",
      "say": "எண்ணூறு ரூப. நல்ல கோட்டண் ஆணு.",
      "meaning": "எண்ணூறு ரூபாய். நல்ல பருத்தி."
    },
    {
      "speaker": "A",
      "text": "അത് വളരെ കൂടുതലാണ്. ഞാൻ അഞ്ഞൂറ് തരാം.",
      "say": "அது வளரெ கூடுதலாணு. ஞான் அஞ்ஞூறு தராம்.",
      "meaning": "அது மிக அதிகம். ஐநூறு தருகிறேன்."
    },
    {
      "speaker": "B",
      "text": "അഞ്ഞൂറിന് പറ്റില്ല. എഴുനൂറ്, അവസാന വില.",
      "say": "அஞ்ஞூறினு பட்டில்ல. எழுனூறு, அவஸான வில.",
      "meaning": "ஐநூறு முடியாது. எழுநூறு, கடைசி விலை."
    },
    {
      "speaker": "A",
      "text": "അറുനൂറ് ആക്കൂ. ഞാൻ രണ്ട് ഷർട്ട് എടുക്കാം.",
      "say": "அறுனூறு ஆக்கூ. ஞான் ரண்டு ஷர்ட்டு எடுக்காம்.",
      "meaning": "அறுநூறு ஆக்குங்கள். இரண்டு சட்டை வாங்குவேன்."
    },
    {
      "speaker": "B",
      "text": "ശരി, ഒന്നിന് അറുനൂറ്. എടുത്തോളൂ.",
      "say": "ஷரி, ஒன்னினு அறுனூறு. எடுத்தோளூ.",
      "meaning": "சரி, ஒன்றுக்கு அறுநூறு. எடுத்துக்கொள்ளுங்கள்."
    }
  ],
