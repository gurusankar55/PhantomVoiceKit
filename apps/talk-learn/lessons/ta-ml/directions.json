{
  "lines": [
    {
      "speaker": "A",
      "text": "ക്ഷമിക്കണം, ബസ് സ്റ്റോപ്പ് എവിടെയാണ്?",
      "say": "க்ஷமிக்கணம், பஸு ஸ்ட்டோப்பு எவிடெயாணு?",
      "meaning": "மன்னிக்கவும், பேருந்து நிறுத்தம் எங்கே இருக்கிறது?"
    },
    {
      "speaker": "B",
      "text": "നേരെ പോകൂ, എന്നിട്ട് ഇടത്തോട്ട് തിരിയൂ.",
      "say": "நேரெ போகூ, என்னிட்டு இடத்தோட்டு திரியூ.",
      "meaning": "நேராகப் போங்கள், பிறகு இடதுபுறம் திரும்புங்கள்."
    },
    {
      "speaker": "A",
      "text": "പിന്നെ അഞ്ച് മിനിറ്റ് നടക്കൂ. സ്റ്റോപ്പ് അമ്പലത്തിനടുത്താണ്.",
      "say": "பின்னெ அஞ்சு மினிட்டு நடக்கூ. ஸ்ட்டோப்பு அம்பலத்தினடுத்தாணு.",
      "meaning": "பிறகு ஐந்து நிமிடம் நடங்கள். நிறுத்தம் கோயிலுக்கு அருகில் உள்ளது."
    },
    {
      "speaker": "B",
      "text": "ഇവിടെ നിന്ന് ദൂരെയാണോ?",
      "say": "இவிடெ நின்னு தூரெயாணோ?",
      "meaning": "இங்கிருந்து தூரமா?"
    },
    {
      "speaker": "A",
      "text": "അല്ല, വളരെ അടുത്താണ്. നടന്നു പോകാം.",
      "say": "அல்ல, வளரெ அடுத்தாணு. நடன்னு போகாம்.",
      "meaning": "இல்லை, மிக அருகில்தான். நடந்தே போகலாம்."
    },
    {
      "speaker": "B",
      "text": "നിങ്ങളുടെ സഹായത്തിന് വളരെ നന്ദി.",
      "say": "நிங்ஙளுடெ ஸஹாயத்தினு வளரெ நந்தி.",
      "meaning": "உங்கள் உதவிக்கு மிக்க நன்றி."
    }
  ],
