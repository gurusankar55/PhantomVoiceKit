{
  "lines": [
    {
      "speaker": "A",
      "text": "നിങ്ങൾക്ക് എവിടെയാണ് പോകേണ്ടത്?",
      "say": "நிங்ஙள்க்கு எவிடெயாணு போகேண்டது?",
      "meaning": "நீங்கள் எங்கே போக வேண்டும்?"
    },
    {
      "speaker": "B",
      "text": "റെയിൽവേ സ്റ്റേഷനിലേക്ക്. എത്ര ആകും?",
      "say": "றெயில்வே ஸ்ட்டேஷனிலேக்கு. எத்ர ஆகும்?",
      "meaning": "ரயில் நிலையத்துக்கு, தயவுசெய்து. எவ்வளவு ஆகும்?"
    },
    {
      "speaker": "A",
      "text": "നൂറ്റമ്പത് രൂപ ആകും.",
      "say": "நூட்டம்பது ரூப ஆகும்.",
      "meaning": "நூற்று ஐம்பது ரூபாய் ஆகும்."
    },
    {
      "speaker": "B",
      "text": "അത് വളരെ കൂടുതലാണ്. മീറ്റർ ഇടൂ.",
      "say": "அது வளரெ கூடுதலாணு. மீட்டர் இடூ.",
      "meaning": "அது அதிகம். மீட்டர் போடுங்கள்."
    },
    {
      "speaker": "A",
      "text": "ശരി, മീറ്റർ ഇടാം. ഇരിക്കൂ.",
      "say": "ஷரி, மீட்டர் இடாம். இரிக்கூ.",
      "meaning": "சரி, மீட்டர் போடுகிறேன். உட்காருங்கள்."
    },
    {
      "speaker": "B",
      "text": "ഇവിടെ നിർത്തൂ. നന്ദി.",
      "say": "இவிடெ நிர்த்தூ. நந்தி.",
      "meaning": "இங்கே நிறுத்துங்கள். நன்றி."
    }
  ],
