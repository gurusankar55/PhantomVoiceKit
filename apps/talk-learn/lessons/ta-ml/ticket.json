{
  "lines": [
    {
      "speaker": "A",
      "text": "ശുഭ സായാഹ്നം. എവിടേക്കാണ് യാത്ര?",
      "say": "ஷுப ஸாயாஹ்னம். எவிடேக்காணு யாத்ர?",
      "meaning": "மாலை வணக்கம். எங்கே பயணம் செய்ய வேண்டும்?"
    },
    {
      "speaker": "B",
      "text": "മുംബൈയിലേക്ക് ഒരു ടിക്കറ്റ് തരൂ. എത്രയാണ് വില?",
      "say": "மும்பையிலேக்கு ஒரு டிக்கட்டு தரூ. எத்ரயாணு வில?",
      "meaning": "மும்பைக்கு ஒரு டிக்கெட், தயவுசெய்து. விலை என்ன?"
    },
    {
      "speaker": "A",
      "text": "നാനൂറ് രൂപ. ട്രെയിൻ ആറ് മണിക്ക് പുറപ്പെടും.",
      "say": "நானூறு ரூப. ட்ரெயின் ஆறு மணிக்கு புறப்பெடும்.",
      "meaning": "நானூறு ரூபாய். ரயில் ஆறு மணிக்குப் புறப்படும்."
    },
    {
      "speaker": "B",
      "text": "ട്രെയിൻ ഏത് പ്ലാറ്റ്ഫോമിൽ നിന്നാണ് പോകുന്നത്?",
      "say": "ட்ரெயின் ஏது ப்லாட்ட்ஃபோமில் நின்னாணு போகுன்னது?",
      "meaning": "ரயில் எந்த நடைமேடையிலிருந்து புறப்படும்?"
    },
    {
      "speaker": "A",
      "text": "മൂന്നാം നമ്പർ പ്ലാറ്റ്ഫോം. നേരത്തെ വരൂ.",
      "say": "மூன்னாம் நம்பர் ப்லாட்ட்ஃபோம். நேரத்தெ வரூ.",
      "meaning": "மூன்றாம் நடைமேடை. சீக்கிரம் வாருங்கள்."
    },
    {
      "speaker": "B",
      "text": "നന്ദി. ഞാൻ നേരത്തെ വരാം.",
      "say": "நந்தி. ஞான் நேரத்தெ வராம்.",
      "meaning": "நன்றி. நான் சீக்கிரம் வருவேன்."
    }
  ],
