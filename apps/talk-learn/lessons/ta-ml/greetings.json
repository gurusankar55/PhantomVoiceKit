    {
      "speaker": "A",
      "text": "നമസ്കാരം! സുഖമാണോ?",
      "say": "நமஸ்காரம்! ஸுகமாணோ?",
      "meaning": "வணக்கம்! எப்படி இருக்கிறீர்கள்?"
    },
    {
      "speaker": "B",
      "text": "എനിക്ക് സുഖമാണ്, നന്ദി. നിങ്ങൾക്കോ?",
      "say": "எனிக்கு ஸுகமாணு, நந்தி. நிங்ஙள்க்கோ?",
      "meaning": "நான் நலமாக இருக்கிறேன், நன்றி. நீங்கள்?"
    },
    {
      "speaker": "A",
      "text": "കണ്ടതിൽ സന്തോഷം. നിങ്ങളുടെ പേര് എന്താണ്?",
      "say": "கண்டதில் ஸந்தோஷம். நிங்ஙளுடெ பேரு எந்தாணு?",
      "meaning": "உங்களைச் சந்தித்ததில் மகிழ்ச்சி. உங்கள் பெயர் என்ன?"
    },
    {
      "speaker": "B",
      "text": "എന്റെ പേര് രവി. ഞാൻ ചെന്നൈയിൽ നിന്നാണ്.",
      "say": "என்டெ பேரு ரவி. ஞான் சென்னையில் நின்னாணு.",
      "meaning": "என் பெயர் ரவி. நான் சென்னையிலிருந்து வருகிறேன்."
    },
    {
      "speaker": "A",
      "text": "സുപ്രഭാതം രവി. ദയവായി ഇരിക്കൂ.",
      "say": "ஸுப்ரபாதம் ரவி. தயவாயி இரிக்கூ.",
      "meaning": "காலை வணக்கம் ரவி. தயவுசெய்து உட்காருங்கள்."
    },
    {
      "speaker": "B",
      "text": "നന്ദി. വീണ്ടും കാണാം!",
      "say": "நந்தி. வீண்டும் காணாம்!",
      "meaning": "நன்றி. மீண்டும் சந்திப்போம்!"
    }
