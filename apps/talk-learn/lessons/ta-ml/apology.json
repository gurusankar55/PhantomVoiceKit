{
  "lines": [
    {
      "speaker": "A",
      "text": "വൈകിയതിന് വളരെ ക്ഷമിക്കണം.",
      "say": "வைகியதினு வளரெ க்ஷமிக்கணம்.",
      "meaning": "தாமதமாக வந்ததற்கு மிகவும் வருந்துகிறேன்."
    },
    {
      "speaker": "B",
      "text": "സാരമില്ല. എന്തു പറ്റി?",
      "say": "ஸாரமில்ல. எந்து பட்டி?",
      "meaning": "பரவாயில்லை. என்ன ஆயிற்று?"
    },
    {
      "speaker": "A",
      "text": "നല്ല ട്രാഫിക് ഉണ്ടായിരുന്നു, എന്റെ ഫോണിന്റെ ബാറ്ററിയും തീർന്നു.",
      "say": "நல்ல ட்ராஃபிகு உண்டாயிருன்னு, என்டெ ஃபோணின்டெ பாட்டறியும் தீர்ன்னு.",
      "meaning": "போக்குவரத்து நெரிசல் அதிகம், என் போனில் பேட்டரியும் தீர்ந்துவிட்டது."
    },
    {
      "speaker": "B",
      "text": "മനസ്സിലായി. പക്ഷേ അടുത്ത തവണ വിളിക്കണം.",
      "say": "மனஸ்ஸிலாயி. பக்ஷே அடுத்த தவண விளிக்கணம்.",
      "meaning": "புரிகிறது. ஆனால் அடுத்த முறை அழையுங்கள்."
    },
    {
      "speaker": "A",
      "text": "നിങ്ങൾ പറഞ്ഞത് ശരിയാണ്. അത് എന്റെ തെറ്റാണ്. ഇനി ഇങ്ങനെ ചെയ്യില്ല.",
      "say": "நிங்ஙள் பறஞ்ஞது ஷரியாணு. அது என்டெ தெட்டாணு. இனி இங்ஙனெ செய்யில்ல.",
      "meaning": "நீங்கள் சொல்வது சரி. அது என் தவறு. மீண்டும் இப்படிச் செய்யமாட்டேன்."
    },
    {
      "speaker": "B",
      "text": "വിഷമിക്കേണ്ട. ഇനി നമുക്ക് ജോലി തുടങ്ങാം.",
      "say": "விஷமிக்கேண்ட. இனி நமுக்கு ஜோலி துடங்ஙாம்.",
      "meaning": "கவலைப்படாதீர்கள். இப்போது வேலையைத் தொடங்குவோம்."
    }
  ],
