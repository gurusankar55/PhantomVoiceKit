{
  "lines": [
    {
      "speaker": "A",
      "text": "സുപ്രഭാതം. എന്താണ് പ്രശ്നം?",
      "say": "ஸுப்ரபாதம். எந்தாணு ப்ரஷ்னம்?",
      "meaning": "காலை வணக்கம். என்ன பிரச்சினை?"
    },
    {
      "speaker": "B",
      "text": "ഇന്നലെ മുതൽ എനിക്ക് പനിയും തലവേദനയും ഉണ്ട്.",
      "say": "இன்னலெ முதல் எனிக்கு பனியும் தலவேதனயும் உண்டு.",
      "meaning": "நேற்றிலிருந்து எனக்குக் காய்ச்சலும் தலைவலியும் இருக்கிறது."
    },
    {
      "speaker": "A",
      "text": "ചുമയോ ജലദോഷമോ ഉണ്ടോ?",
      "say": "சுமயோ ஜலதோஷமோ உண்டோ?",
      "meaning": "இருமல் அல்லது சளி இருக்கிறதா?"
    },
    {
      "speaker": "B",
      "text": "ഇല്ല, പനി മാത്രം. ക്ഷീണം തോന്നുന്നു.",
      "say": "இல்ல, பனி மாத்ரம். க்ஷீணம் தோன்னுன்னு.",
      "meaning": "இல்லை, காய்ச்சல் மட்டும்தான். பலவீனமாக உணர்கிறேன்."
    },
    {
      "speaker": "A",
      "text": "ഈ മരുന്ന് ദിവസം മൂന്നു നേരം കഴിക്കൂ. ചൂടുവെള്ളം കുടിക്കൂ.",
      "say": "ஈ மருன்னு திவஸம் மூன்னு நேரம் கழிக்கூ. சூடுவெள்ளம் குடிக்கூ.",
      "meaning": "இந்த மருந்தை நாளுக்கு மூன்று முறை சாப்பிடுங்கள். வெந்நீர் குடியுங்கள்."
    },
    {
      "speaker": "B",
      "text": "നന്ദി ഡോക്ടർ. ഇനി എപ്പോഴാണ് വരേണ്ടത്?",
      "say": "நந்தி டோக்டர். இனி எப்போழாணு வரேண்டது?",
      "meaning": "நன்றி டாக்டர். மீண்டும் எப்போது வர வேண்டும்?"
    }
  ],
