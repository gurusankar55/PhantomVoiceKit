  "lines": [
    {
      "speaker": "A",
      "text": "എല്ലാവർക്കും സുപ്രഭാതം. നമുക്ക് മീറ്റിംഗ് തുടങ്ങാം.",
      "say": "எல்லாவர்க்கும் ஸுப்ரபாதம். நமுக்கு மீட்டிங்கு துடங்ஙாம்.",
      "meaning": "அனைவருக்கும் காலை வணக்கம். கூட்டத்தைத் தொடங்கலாம்."
    },
    {
      "speaker": "B",
      "text": "ഈ ആഴ്ച നമ്മൾ റിപ്പോർട്ട് പൂർത്തിയാക്കണം.",
      "say": "ஈ ஆழ்ச நம்மள் றிப்போர்ட்டு பூர்த்தியாக்கணம்.",
      "meaning": "இந்த வாரம் அறிக்கையை முடிக்க வேண்டும்."
    },
    {
      "speaker": "A",
      "text": "ആദ്യ ഭാഗം ഞാൻ എഴുതാം. രണ്ടാം ഭാഗം ആരാണ് ചെയ്യുന്നത്?",
      "say": "ஆத்ய பாகம் ஞான் எழுதாம். ரண்டாம் பாகம் ஆராணு செய்யுன்னது?",
      "meaning": "முதல் பகுதியை நான் எழுதுகிறேன். இரண்டாம் பகுதியை யார் செய்வார்கள்?"
    },
    {
      "speaker": "B",
      "text": "ഞാൻ ചെയ്യാം. വെള്ളിയാഴ്ചയാണോ അവസാന തീയതി?",
      "say": "ஞான் செய்யாம். வெள்ளியாழ்சயாணோ அவஸான தீயதி?",
      "meaning": "நான் செய்கிறேன். வெள்ளிக்கிழமை கடைசி நாளா?"
    },
    {
      "speaker": "A",
      "text": "അതെ, അഞ്ചു മണിക്ക് മുമ്പ് അയയ്ക്കൂ.",
      "say": "அதெ, அஞ்சு மணிக்கு மும்பு அயய்க்கூ.",
      "meaning": "ஆம், ஐந்து மணிக்கு முன் அனுப்புங்கள்."
    },
    {
      "speaker": "B",
      "text": "ആർക്കെങ്കിലും ചോദ്യമുണ്ടോ? എല്ലാവർക്കും നന്ദി.",
      "say": "ஆர்க்கெங்கிலும் சோத்யமுண்டோ? எல்லாவர்க்கும் நந்தி.",
      "meaning": "யாருக்காவது கேள்வி இருக்கிறதா? அனைவருக்கும் நன்றி."
