{
  "lines": [
    {
      "speaker": "A",
      "text": "അമ്മേ, ഇന്ന് എന്താണ് പാചകം?",
      "say": "அம்மே, இன்னு எந்தாணு பாசகம்?",
      "meaning": "அம்மா, இன்று என்ன சமைக்கிறீர்கள்?"
    },
    {
      "speaker": "B",
      "text": "ചോറും സാമ്പാറും ഉണ്ടാക്കുകയാണ്. ഫാൻ ഇടൂ.",
      "say": "சோறும் ஸாம்பாறும் உண்டாக்குகயாணு. ஃபான் இடூ.",
      "meaning": "சாதமும் சாம்பாரும் செய்கிறேன். மின்விசிறியைப் போடு."
    },
    {
      "speaker": "A",
      "text": "ഇന്ന് നല്ല ചൂടാണ്. ജനൽ തുറക്കട്ടെ?",
      "say": "இன்னு நல்ல சூடாணு. ஜனல் துறக்கட்டெ?",
      "meaning": "இன்று மிகவும் வெயில். ஜன்னலைத் திறக்கவா?"
    },
    {
      "speaker": "B",
      "text": "അതെ, തുറക്ക്. നിന്റെ മുറിയും വൃത്തിയാക്ക്.",
      "say": "அதெ, துறக்கு. நின்டெ முறியும் வ்ருத்தியாக்கு.",
      "meaning": "ஆம், திற. உன் அறையையும் சுத்தம் செய்."
    },
    {
      "speaker": "A",
      "text": "അത്താഴം കഴിഞ്ഞ് ചെയ്യാം. അച്ഛൻ വീട്ടിലുണ്ടോ?",
      "say": "அத்தாழம் கழிஞ்ஞு செய்யாம். அச்சன் வீட்டிலுண்டோ?",
      "meaning": "இரவு உணவுக்குப் பிறகு செய்கிறேன். அப்பா வீட்டில் இருக்கிறாரா?"
    },
    {
      "speaker": "B",
      "text": "അച്ഛൻ എട്ടു മണിക്ക് വരും. മേശ ഒരുക്കൂ.",
      "say": "அச்சன் எட்டு மணிக்கு வரும். மேஷ ஒருக்கூ.",
      "meaning": "அவர் எட்டு மணிக்கு வருவார். மேசையைத் தயார் செய்."
    }
  ],
