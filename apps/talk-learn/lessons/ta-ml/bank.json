{
  "lines": [
    {
      "speaker": "A",
      "text": "സുപ്രഭാതം. ഞാൻ എങ്ങനെ സഹായിക്കണം?",
      "say": "ஸுப்ரபாதம். ஞான் எங்ஙனெ ஸஹாயிக்கணம்?",
      "meaning": "காலை வணக்கம். நான் எப்படி உதவலாம்?"
    },
    {
      "speaker": "B",
      "text": "എനിക്ക് ഒരു സേവിംഗ്സ് അക്കൗണ്ട് തുടങ്ങണം.",
      "say": "எனிக்கு ஒரு ஸேவிங்க்ஸு அக்கௌண்டு துடங்ஙணம்.",
      "meaning": "நான் ஒரு சேமிப்புக் கணக்கு தொடங்க விரும்புகிறேன்."
    },
    {
      "speaker": "A",
      "text": "ഈ ഫോം പൂരിപ്പിക്കൂ. നിങ്ങളുടെ ഫോട്ടോയും ആധാർ കാർഡും വേണം.",
      "say": "ஈ ஃபோம் பூரிப்பிக்கூ. நிங்ஙளுடெ ஃபோட்டோயும் ஆதார் கார்டும் வேணம்.",
      "meaning": "இந்தப் படிவத்தை நிரப்புங்கள். உங்கள் புகைப்படமும் ஆதார் அட்டையும் வேண்டும்."
    },
    {
      "speaker": "B",
      "text": "ഇതാ. എത്ര പൈസ നിക്ഷേപിക്കണം?",
      "say": "இதா. எத்ர பைஸ நிக்ஷேபிக்கணம்?",
      "meaning": "இதோ. எவ்வளவு பணம் போட வேண்டும்?"
    },
    {
      "speaker": "A",
      "text": "അഞ്ഞൂറ് രൂപ മതി. ഇവിടെ ഒപ്പിടൂ.",
      "say": "அஞ்ஞூறு ரூப மதி. இவிடெ ஒப்பிடூ.",
      "meaning": "ஐநூறு ரூபாய் போதும். இங்கே கையெழுத்துப் போடுங்கள்."
    },
    {
      "speaker": "B",
      "text": "കഴിഞ്ഞു. നിങ്ങളുടെ പാസ്ബുക്ക് ഒരാഴ്ചയ്ക്കുള്ളിൽ വരും.",
      "say": "கழிஞ்ஞு. நிங்ஙளுடெ பாஸ்புக்கு ஒராழ்சய்க்குள்ளில் வரும்.",
      "meaning": "முடிந்தது. உங்கள் வங்கிப் புத்தகம் ஒரு வாரத்தில் வரும்."
    }
  ],
