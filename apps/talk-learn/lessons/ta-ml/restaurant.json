{
  "lines": [
    {
      "speaker": "A",
      "text": "സ്വാഗതം. രണ്ടു പേർക്കുള്ള മേശ വേണോ?",
      "say": "ஸ்வாகதம். ரண்டு பேர்க்குள்ள மேஷ வேணோ?",
      "meaning": "வரவேற்கிறோம். இரண்டு பேருக்கு மேசையா?"
    },
    {
      "speaker": "B",
      "text": "അതെ. മെനു കാണാമോ?",
      "say": "அதெ. மெனு காணாமோ?",
      "meaning": "ஆம். மெனுவைப் பார்க்கலாமா?"
    },
    {
      "speaker": "A",
      "text": "തീർച്ചയായും. എന്താണ് കഴിക്കാൻ വേണ്ടത്?",
      "say": "தீர்ச்சயாயும். எந்தாணு கழிக்கான் வேண்டது?",
      "meaning": "நிச்சயமாக. என்ன சாப்பிட விரும்புகிறீர்கள்?"
    },
    {
      "speaker": "B",
      "text": "ഒരു വെജ് ബിരിയാണിയും രണ്ട് ചപ്പാത്തിയും. വെള്ളവും തരൂ.",
      "say": "ஒரு வெஜு பிரியாணியும் ரண்டு சப்பாத்தியும். வெள்ளவும் தரூ.",
      "meaning": "ஒரு காய்கறி பிரியாணி, இரண்டு சப்பாத்தி. தண்ணீரும் கொடுங்கள்."
    },
    {
      "speaker": "A",
      "text": "ഇതാ നിങ്ങളുടെ ഭക്ഷണം. നന്നായി കഴിക്കൂ!",
      "say": "இதா நிங்ஙளுடெ பக்ஷணம். நன்னாயி கழிக்கூ!",
      "meaning": "இதோ உங்கள் உணவு. சாப்பிடுங்கள்!"
    },
    {
      "speaker": "B",
      "text": "നല്ല രുചിയുണ്ട്. ബിൽ തരൂ.",
      "say": "நல்ல ருசியுண்டு. பில் தரூ.",
      "meaning": "சுவையாக இருக்கிறது. பில் கொடுங்கள்."
    }
  ],
