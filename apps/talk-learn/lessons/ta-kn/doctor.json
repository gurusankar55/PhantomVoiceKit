    {
      "speaker": "A",
      "text": "ಶುಭೋದಯ. ಏನು ತೊಂದರೆ?",
      "say": "ஷுபோதய. ஏனு தொந்தரெ?",
      "meaning": "காலை வணக்கம். என்ன பிரச்சினை?"
    },
    {
      "speaker": "B",
      "text": "ನಿನ್ನೆಯಿಂದ ನನಗೆ ಜ್ವರ ಮತ್ತು ತಲೆನೋವು ಇದೆ.",
      "say": "நின்னெயிந்த நனகெ ஜ்வர மத்து தலெனோவு இதெ.",
      "meaning": "நேற்றிலிருந்து எனக்குக் காய்ச்சலும் தலைவலியும் இருக்கிறது."
    },
    {
      "speaker": "A",
      "text": "ಕೆಮ್ಮು ಅಥವಾ ನೆಗಡಿ ಇದೆಯಾ?",
      "say": "கெம்மு அதவா நெகடி இதெயா?",
      "meaning": "இருமல் அல்லது சளி இருக்கிறதா?"
    },
    {
      "speaker": "B",
      "text": "ಇಲ್ಲ, ಜ್ವರ ಮಾತ್ರ. ತುಂಬಾ ಸುಸ್ತಾಗಿದೆ.",
      "say": "இல்ல, ஜ்வர மாத்ர. தும்பா ஸுஸ்தாகிதெ.",
      "meaning": "இல்லை, காய்ச்சல் மட்டும்தான். பலவீனமாக உணர்கிறேன்."
    },
    {
      "speaker": "A",
      "text": "ಈ ಮಾತ್ರೆಯನ್ನು ದಿನಕ್ಕೆ ಮೂರು ಸಲ ತಗೊಳ್ಳಿ. ಬಿಸಿ ನೀರು ಕುಡಿಯಿರಿ.",
      "say": "ஈ மாத்ரெயன்னு தினக்கெ மூரு ஸல தகொள்ளி. பிஸி நீரு குடியிரி.",
      "meaning": "இந்த மருந்தை நாளுக்கு மூன்று முறை சாப்பிடுங்கள். வெந்நீர் குடியுங்கள்."
    },
    {
      "speaker": "B",
      "text": "ಧನ್ಯವಾದಗಳು ಡಾಕ್ಟರ್. ಮತ್ತೆ ಯಾವಾಗ ಬರಬೇಕು?",
      "say": "தன்யவாதகளு டாக்டர். மத்தெ யாவாக பரபேகு?",
      "meaning": "நன்றி டாக்டர். மீண்டும் எப்போது வர வேண்டும்?"
    }
