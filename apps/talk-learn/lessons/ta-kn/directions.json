{
  "lines": [
    {
      "speaker": "A",
      "text": "ಕ್ಷಮಿಸಿ, ಬಸ್ ನಿಲ್ದಾಣ ಎಲ್ಲಿದೆ?",
      "say": "க்ஷமிஸி, பஸ் நில்தாண எல்லிதெ?",
      "meaning": "மன்னிக்கவும், பேருந்து நிறுத்தம் எங்கே இருக்கிறது?"
    },
    {
      "speaker": "B",
      "text": "ನೇರವಾಗಿ ಹೋಗಿ, ಆಮೇಲೆ ಎಡಕ್ಕೆ ತಿರುಗಿ.",
      "say": "நேரவாகி ஹோகி, ஆமேலெ எடக்கெ திருகி.",
      "meaning": "நேராகப் போங்கள், பிறகு இடதுபுறம் திரும்புங்கள்."
    },
    {
      "speaker": "A",
      "text": "ಆಮೇಲೆ ಐದು ನಿಮಿಷ ನಡೆಯಿರಿ. ನಿಲ್ದಾಣ ದೇವಸ್ಥಾನದ ಹತ್ತಿರ ಇದೆ.",
      "say": "ஆமேலெ ஐது நிமிஷ நடெயிரி. நில்தாண தேவஸ்தானத ஹத்திர இதெ.",
      "meaning": "பிறகு ஐந்து நிமிடம் நடங்கள். நிறுத்தம் கோயிலுக்கு அருகில் உள்ளது."
    },
    {
      "speaker": "B",
      "text": "ಇಲ್ಲಿಂದ ದೂರ ಇದೆಯಾ?",
      "say": "இல்லிந்த தூர இதெயா?",
      "meaning": "இங்கிருந்து தூரமா?"
    },
    {
      "speaker": "A",
      "text": "ಇಲ್ಲ, ತುಂಬಾ ಹತ್ತಿರ. ನಡೆದುಕೊಂಡೇ ಹೋಗಬಹುದು.",
      "say": "இல்ல, தும்பா ஹத்திர. நடெதுகொண்டே ஹோகபஹுது.",
      "meaning": "இல்லை, மிக அருகில்தான். நடந்தே போகலாம்."
    },
    {
      "speaker": "B",
      "text": "ನಿಮ್ಮ ಸಹಾಯಕ್ಕೆ ತುಂಬಾ ಧನ್ಯವಾದಗಳು.",
      "say": "நிம்ம ஸஹாயக்கெ தும்பா தன்யவாதகளு.",
      "meaning": "உங்கள் உதவிக்கு மிக்க நன்றி."
    }
  ],
