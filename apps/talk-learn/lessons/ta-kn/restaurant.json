{
  "lines": [
    {
      "speaker": "A",
      "text": "ಸ್ವಾಗತ. ಇಬ್ಬರಿಗೆ ಟೇಬಲ್ ಬೇಕಾ?",
      "say": "ஸ்வாகத. இப்பரிகெ டேபல் பேகா?",
      "meaning": "வரவேற்கிறோம். இரண்டு பேருக்கு மேசையா?"
    },
    {
      "speaker": "B",
      "text": "ಹೌದು. ಮೆನು ನೋಡಬಹುದಾ?",
      "say": "ஹௌது. மெனு நோடபஹுதா?",
      "meaning": "ஆம். மெனுவைப் பார்க்கலாமா?"
    },
    {
      "speaker": "A",
      "text": "ಖಂಡಿತ. ಏನು ತಿನ್ನೋಕೆ ಇಷ್ಟಪಡ್ತೀರಾ?",
      "say": "கண்டித. ஏனு தின்னோகெ இஷ்டபட்தீரா?",
      "meaning": "நிச்சயமாக. என்ன சாப்பிட விரும்புகிறீர்கள்?"
    },
    {
      "speaker": "B",
      "text": "ಒಂದು ವೆಜ್ ಬಿರಿಯಾನಿ ಮತ್ತು ಎರಡು ಚಪಾತಿ. ನೀರು ಕೂಡ ಕೊಡಿ.",
      "say": "ஒந்து வெஜ் பிரியானி மத்து எரடு சபாதி. நீரு கூட கொடி.",
      "meaning": "ஒரு காய்கறி பிரியாணி, இரண்டு சப்பாத்தி. தண்ணீரும் கொடுங்கள்."
    },
    {
      "speaker": "A",
      "text": "ಇಗೋ ನಿಮ್ಮ ಊಟ. ಚೆನ್ನಾಗಿ ತಿನ್ನಿ!",
      "say": "இகோ நிம்ம ஊட. சென்னாகி தின்னி!",
      "meaning": "இதோ உங்கள் உணவு. சாப்பிடுங்கள்!"
    },
    {
      "speaker": "B",
      "text": "ತುಂಬಾ ರುಚಿಯಾಗಿದೆ. ಬಿಲ್ ಕೊಡಿ.",
      "say": "தும்பா ருசியாகிதெ. பில் கொடி.",
      "meaning": "சுவையாக இருக்கிறது. பில் கொடுங்கள்."
    }
  ],
