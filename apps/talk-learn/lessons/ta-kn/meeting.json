{
  "lines": [
    {
      "speaker": "A",
      "text": "ಎಲ್ಲರಿಗೂ ಶುಭೋದಯ. ಸಭೆ ಶುರು ಮಾಡೋಣ.",
      "say": "எல்லரிகூ ஷுபோதய. ஸபெ ஷுரு மாடோண.",
      "meaning": "அனைவருக்கும் காலை வணக்கம். கூட்டத்தைத் தொடங்கலாம்."
    },
    {
      "speaker": "B",
      "text": "ಈ ವಾರ ನಾವು ರಿಪೋರ್ಟ್ ಮುಗಿಸಬೇಕು.",
      "say": "ஈ வார நாவு ரிபோர்ட் முகிஸபேகு.",
      "meaning": "இந்த வாரம் அறிக்கையை முடிக்க வேண்டும்."
    },
    {
      "speaker": "A",
      "text": "ಮೊದಲ ಭಾಗ ನಾನು ಬರೀತೀನಿ. ಎರಡನೇ ಭಾಗ ಯಾರು ಮಾಡ್ತಾರೆ?",
      "say": "மொதல பாக நானு பரீதீனி. எரடனே பாக யாரு மாட்தாரெ?",
      "meaning": "முதல் பகுதியை நான் எழுதுகிறேன். இரண்டாம் பகுதியை யார் செய்வார்கள்?"
    },
    {
      "speaker": "B",
      "text": "ನಾನು ಮಾಡ್ತೀನಿ. ಶುಕ್ರವಾರ ಕೊನೆಯ ದಿನಾನಾ?",
      "say": "நானு மாட்தீனி. ஷுக்ரவார கொனெய தினானா?",
      "meaning": "நான் செய்கிறேன். வெள்ளிக்கிழமை கடைசி நாளா?"
    },
    {
      "speaker": "A",
      "text": "ಹೌದು, ಐದು ಗಂಟೆ ಒಳಗೆ ಕಳಿಸಿ.",
      "say": "ஹௌது, ஐது கண்டெ ஒளகெ களிஸி.",
      "meaning": "ஆம், ஐந்து மணிக்கு முன் அனுப்புங்கள்."
    },
    {
      "speaker": "B",
      "text": "ಯಾರಿಗಾದರೂ ಪ್ರಶ್ನೆ ಇದೆಯಾ? ಎಲ್ಲರಿಗೂ ಧನ್ಯವಾದಗಳು.",
      "say": "யாரிகாதரூ ப்ரஷ்னெ இதெயா? எல்லரிகூ தன்யவாதகளு.",
      "meaning": "யாருக்காவது கேள்வி இருக்கிறதா? அனைவருக்கும் நன்றி."
    }
  ],
