{
  "lines": [
    {
      "speaker": "A",
      "text": "ನಮಸ್ಕಾರ! ಹೇಗಿದ್ದೀರಾ?",
      "say": "நமஸ்கார! ஹேகித்தீரா?",
      "meaning": "வணக்கம்! எப்படி இருக்கிறீர்கள்?"
    },
    {
      "speaker": "B",
      "text": "ನಾನು ಚೆನ್ನಾಗಿದ್ದೀನಿ, ಧನ್ಯವಾದಗಳು. ನೀವು?",
      "say": "நானு சென்னாகித்தீனி, தன்யவாதகளு. நீவு?",
      "meaning": "நான் நலமாக இருக்கிறேன், நன்றி. நீங்கள்?"
    },
    {
      "speaker": "A",
      "text": "ನಿಮ್ಮನ್ನು ಭೇಟಿಯಾಗಿ ಸಂತೋಷ ಆಯಿತು. ನಿಮ್ಮ ಹೆಸರೇನು?",
      "say": "நிம்மன்னு பேடியாகி ஸந்தோஷ ஆயிது. நிம்ம ஹெஸரேனு?",
      "meaning": "உங்களைச் சந்தித்ததில் மகிழ்ச்சி. உங்கள் பெயர் என்ன?"
    },
    {
      "speaker": "B",
      "text": "ನನ್ನ ಹೆಸರು ರವಿ. ನಾನು ಚೆನ್ನೈನವನು.",
      "say": "நன்ன ஹெஸரு ரவி. நானு சென்னைனவனு.",
      "meaning": "என் பெயர் ரவி. நான் சென்னையிலிருந்து வருகிறேன்."
    },
    {
      "speaker": "A",
      "text": "ಶುಭೋದಯ ರವಿ. ದಯವಿಟ್ಟು ಕುಳಿತುಕೊಳ್ಳಿ.",
      "say": "ஷுபோதய ரவி. தயவிட்டு குளிதுகொள்ளி.",
      "meaning": "காலை வணக்கம் ரவி. தயவுசெய்து உட்காருங்கள்."
    },
    {
      "speaker": "B",
      "text": "ಧನ್ಯವಾದಗಳು. ಮತ್ತೆ ಸಿಗೋಣ!",
      "say": "தன்யவாதகளு. மத்தெ ஸிகோண!",
      "meaning": "நன்றி. மீண்டும் சந்திப்போம்!"
    }
  ],
