{
  "lines": [
    {
      "speaker": "A",
      "text": "ನೀವು ಎಲ್ಲಿಗೆ ಹೋಗಬೇಕು?",
      "say": "நீவு எல்லிகெ ஹோகபேகு?",
      "meaning": "நீங்கள் எங்கே போக வேண்டும்?"
    },
    {
      "speaker": "B",
      "text": "ರೈಲು ನಿಲ್ದಾಣಕ್ಕೆ. ಎಷ್ಟು ಆಗುತ್ತೆ?",
      "say": "ரைலு நில்தாணக்கெ. எஷ்டு ஆகுத்தெ?",
      "meaning": "ரயில் நிலையத்துக்கு, தயவுசெய்து. எவ்வளவு ஆகும்?"
    },
    {
      "speaker": "A",
      "text": "ನೂರ ಐವತ್ತು ರೂಪಾಯಿ ಆಗುತ್ತೆ.",
      "say": "நூர ஐவத்து ரூபாயி ஆகுத்தெ.",
      "meaning": "நூற்று ஐம்பது ரூபாய் ஆகும்."
    },
    {
      "speaker": "B",
      "text": "ಅದು ತುಂಬಾ ಜಾಸ್ತಿ. ದಯವಿಟ್ಟು ಮೀಟರ್ ಹಾಕಿ.",
      "say": "அது தும்பா ஜாஸ்தி. தயவிட்டு மீடர் ஹாகி.",
      "meaning": "அது அதிகம். மீட்டர் போடுங்கள்."
    },
    {
      "speaker": "A",
      "text": "ಸರಿ, ಮೀಟರ್ ಹಾಕ್ತೀನಿ. ಕುಳಿತುಕೊಳ್ಳಿ.",
      "say": "ஸரி, மீடர் ஹாக்தீனி. குளிதுகொள்ளி.",
      "meaning": "சரி, மீட்டர் போடுகிறேன். உட்காருங்கள்."
    },
    {
      "speaker": "B",
      "text": "ಇಲ್ಲೇ ನಿಲ್ಲಿಸಿ. ಧನ್ಯವಾದಗಳು.",
      "say": "இல்லே நில்லிஸி. தன்யவாதகளு.",
      "meaning": "இங்கே நிறுத்துங்கள். நன்றி."
    }
  ],
