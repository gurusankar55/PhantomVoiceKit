    {
      "speaker": "A",
      "text": "ಸರ್, ಈ ಶರ್ಟ್ ಎಷ್ಟು?",
      "say": "ஸர், ஈ ஷர்ட் எஷ்டு?",
      "meaning": "ஐயா, இந்தச் சட்டை என்ன விலை?"
    },
    {
      "speaker": "B",
      "text": "ಎಂಟು ನೂರು ರೂಪಾಯಿ. ಒಳ್ಳೆ ಹತ್ತಿ ಬಟ್ಟೆ.",
      "say": "எண்டு நூரு ரூபாயி. ஒள்ளெ ஹத்தி பட்டெ.",
      "meaning": "எண்ணூறு ரூபாய். நல்ல பருத்தி."
    },
    {
      "speaker": "A",
      "text": "ಅದು ತುಂಬಾ ಜಾಸ್ತಿ. ಐನೂರು ಕೊಡ್ತೀನಿ.",
      "say": "அது தும்பா ஜாஸ்தி. ஐனூரு கொட்தீனி.",
      "meaning": "அது மிக அதிகம். ஐநூறு தருகிறேன்."
    },
    {
      "speaker": "B",
      "text": "ಐನೂರಕ್ಕೆ ಆಗಲ್ಲ. ಏಳು ನೂರು, ಕೊನೆಯ ಬೆಲೆ.",
      "say": "ஐனூரக்கெ ஆகல்ல. ஏளு நூரு, கொனெய பெலெ.",
      "meaning": "ஐநூறு முடியாது. எழுநூறு, கடைசி விலை."
    },
    {
      "speaker": "A",
      "text": "ಆರು ನೂರು ಮಾಡಿ. ನಾನು ಎರಡು ಶರ್ಟ್ ತಗೊಳ್ತೀನಿ.",
      "say": "ஆரு நூரு மாடி. நானு எரடு ஷர்ட் தகொள்தீனி.",
      "meaning": "அறுநூறு ஆக்குங்கள். இரண்டு சட்டை வாங்குவேன்."
    },
    {
      "speaker": "B",
      "text": "ಸರಿ, ಒಂದಕ್ಕೆ ಆರು ನೂರು. ತಗೊಳ್ಳಿ.",
      "say": "ஸரி, ஒந்தக்கெ ஆரு நூரு. தகொள்ளி.",
      "meaning": "சரி, ஒன்றுக்கு அறுநூறு. எடுத்துக்கொள்ளுங்கள்."
    }
  ],
